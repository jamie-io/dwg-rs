diff --git a/include/dwg.h b/include/dwg.h
index 49c2f66..547ad93 100644
--- a/include/dwg.h
+++ b/include/dwg.h
@@ -11160,6 +11160,11 @@ typedef struct _dwg_AcDs
   Dwg_AcDs_SchemaData schdat;
   Dwg_AcDs_Search search;
   Dwg_AcDs_Segment *segments;
+  /* The decompressed section. The SAB streams of r2013+ solids live here
+     (big ones paged across blob01 segments) but are not attached to the
+     entities, so callers need the raw data. */
+  BITCODE_RC *raw;
+  size_t raw_size;
 } Dwg_AcDs;
 
 typedef struct _dwg_header
diff --git a/src/decode.c b/src/decode.c
index 59d87b7..a4dfed2 100644
--- a/src/decode.c
+++ b/src/decode.c
@@ -3439,8 +3439,10 @@ read_2004_section_acds (Bit_Chain *restrict dat, Dwg_Data *restrict dwg)
   error &= ~DWG_ERR_SECTIONNOTFOUND;
 
   LOG_TRACE ("\n");
-  if (sec_dat.chain)
-    free (sec_dat.chain);
+  // keep the section for callers, see Dwg_AcDs.raw; freed in dwg_free
+  free (dwg->acds.raw);
+  dwg->acds.raw = sec_dat.chain;
+  dwg->acds.raw_size = sec_dat.size;
   *dat = old_dat; // unrestrict
   return error;
 }
