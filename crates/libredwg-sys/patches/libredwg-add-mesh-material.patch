+static int
+mesh_edge_cmp (const void *a, const void *b)
+{
+  const uint64_t x = *(const uint64_t *)a;
+  const uint64_t y = *(const uint64_t *)b;
+  return x < y ? -1 : x > y;
+}
+
+/* AcDbSubDMesh as its level 0 cage. faces is the DXF 90 list: per face the
+   number of vertices, then their indices. The edges are derived from the
+   faces, all with crease 0. */
+EXPORT Dwg_Entity_MESH *
+dwg_add_MESH (Dwg_Object_BLOCK_HEADER *restrict blkhdr,
+              const unsigned num_vertex, const dwg_point_3d *restrict verts,
+              const unsigned num_faces, const BITCODE_BL *restrict faces)
+{
+  uint64_t *keys;
+  unsigned num_keys = 0, num_edges = 0, i, j;
+  {
+    int err;
+    Dwg_Object *hdr = dwg_obj_generic_to_object (blkhdr, &err);
+    Dwg_Data *dwg = hdr ? hdr->parent : NULL;
+    if (dwg && dwg->header.version < R_2010)
+      {
+        LOG_ERROR ("Invalid entity %s <r2010", "MESH");
+        return NULL;
+      }
+    if (dwg)
+      REQUIRE_CLASS ("MESH");
+  }
+  for (i = 0; i < num_faces; i += faces[i] + 1)
+    {
+      if (faces[i] < 3 || faces[i] > num_faces - i - 1)
+        {
+          LOG_ERROR ("%s: invalid face at %u", __FUNCTION__, i);
+          return NULL;
+        }
+      for (j = 1; j <= faces[i]; j++)
+        if (faces[i + j] >= num_vertex)
+          {
+            LOG_ERROR ("%s: invalid vertex index at %u", __FUNCTION__, i + j);
+            return NULL;
+          }
+      num_keys += faces[i];
+    }
+  keys = (uint64_t *)malloc ((num_keys ? num_keys : 1) * sizeof (uint64_t));
+  if (!keys)
+    return NULL;
+  num_keys = 0;
+  for (i = 0; i < num_faces; i += faces[i] + 1)
+    for (j = 1; j <= faces[i]; j++)
+      {
+        const uint64_t a = faces[i + j];
+        const uint64_t b = faces[i + (j % faces[i]) + 1];
+        keys[num_keys++] = a < b ? a << 32 | b : b << 32 | a;
+      }
+  qsort (keys, num_keys, sizeof (uint64_t), mesh_edge_cmp);
+  for (i = 0; i < num_keys; i++)
+    if (!num_edges || keys[i] != keys[num_edges - 1])
+      keys[num_edges++] = keys[i];
+  {
+    API_ADD_ENTITY (MESH);
+    _obj->dlevel = 2;
+    _obj->is_watertight = 0;
+    _obj->num_subdiv_vertex = 0; /* the subdivision level */
+    _obj->num_vertex = num_vertex;
+    _obj->vertex = (BITCODE_3DPOINT *)calloc (num_vertex ? num_vertex : 1,
+                                              sizeof (BITCODE_3DPOINT));
+    _obj->num_faces = num_faces;
+    _obj->faces = (BITCODE_BL *)calloc (num_faces ? num_faces : 1,
+                                        sizeof (BITCODE_BL));
+    _obj->num_edges = num_edges;
+    _obj->edges = (Dwg_MESH_edge *)calloc (num_edges ? num_edges : 1,
+                                           sizeof (Dwg_MESH_edge));
+    _obj->num_crease = num_edges;
+    _obj->crease = (BITCODE_BD *)calloc (num_edges ? num_edges : 1,
+                                         sizeof (BITCODE_BD));
+    if (!_obj->vertex || !_obj->faces || !_obj->edges || !_obj->crease)
+      {
+        LOG_ERROR ("%s: Out of memory", __FUNCTION__);
+        free (keys);
+        API_UNADD_ENTITY;
+        return NULL;
+      }
+    for (i = 0; i < num_vertex; i++)
+      {
+        _obj->vertex[i].x = verts[i].x;
+        _obj->vertex[i].y = verts[i].y;
+        _obj->vertex[i].z = verts[i].z;
+      }
+    memcpy (_obj->faces, faces, num_faces * sizeof (BITCODE_BL));
+    for (i = 0; i < num_edges; i++)
+      {
+        _obj->edges[i].parent = _obj;
+        _obj->edges[i].idxfrom = (BITCODE_BL)(keys[i] >> 32);
+        _obj->edges[i].idxto = (BITCODE_BL)(keys[i] & 0xFFFFFFFF);
+      }
+    free (keys);
+    _obj->unknown_b1 = 1;
+    _obj->unknown_b2 = 0;
+    return _obj;
+  }
+}
+
+static void
+material_defaults (Dwg_Data *restrict dwg, Dwg_Object_MATERIAL *restrict _obj)
+{
+  Dwg_MATERIAL_mapper *maps[]
+      = { &_obj->diffusemap,   &_obj->specularmap, &_obj->reflectionmap,
+          &_obj->opacitymap,   &_obj->bumpmap,     &_obj->refractionmap };
+  _obj->ambient_color.factor = 1.0;
+  _obj->diffuse_color.factor = 1.0;
+  _obj->specular_color.factor = 1.0;
+  _obj->specular_gloss_factor = 0.5;
+  _obj->opacity_percent = 1.0;
+  _obj->refraction_index = 1.0;
+  _obj->channel_flags = 127;
+  for (unsigned i = 0; i < sizeof (maps) / sizeof (maps[0]); i++)
+    {
+      Dwg_MATERIAL_mapper *map = maps[i];
+      map->blendfactor = 1.0;
+      map->source = 1;
+      map->projection = 1;
+      map->tiling = 1;
+      map->autotransform = 1;
+      map->filename = dwg_add_u8_input (dwg, "");
+      map->transmatrix = (BITCODE_BD *)calloc (16, sizeof (BITCODE_BD));
+      if (map->transmatrix)
+        for (unsigned k = 0; k < 16; k += 5)
+          map->transmatrix[k] = 1.0;
+    }
+}
+
+/* Adds a MATERIAL object to the ACAD_MATERIAL dictionary */
+static Dwg_Object_MATERIAL *
+add_material (Dwg_Data *restrict dwg, Dwg_Object_DICTIONARY *restrict dict,
+              const BITCODE_RLL dict_ref, const char *restrict name)
+{
+  API_ADD_OBJECT (MATERIAL);
+  _obj->name = dwg_add_u8_input (dwg, name);
+  _obj->description = dwg_add_u8_input (dwg, "");
+  material_defaults (dwg, _obj);
+  /* owner is relative, reactor absolute */
+  obj->tio.object->ownerhandle = dwg_add_handleref (dwg, 4, dict_ref, obj);
+  add_obj_reactor (obj->tio.object, dict_ref);
+  dwg_add_DICTIONARY_item (dict, name, obj->handle.value);
+  return _obj;
+}
+
+/* A MATERIAL object (r2007+), with the ACAD_MATERIAL dictionary and its
+   ByLayer, ByBlock and Global materials created on first use. Callers set
+   the colors and maps. */
+EXPORT Dwg_Object_MATERIAL *
+dwg_add_MATERIAL (Dwg_Data *restrict dwg, const char *restrict name)
+{
+  Dwg_Object_DICTIONARY *dict = NULL;
+  Dwg_Object *dictobj;
+  BITCODE_RLL dict_ref;
+  int error;
+  if (dwg->header.version < R_2007)
+    {
+      LOG_ERROR ("Invalid object %s <r2007", "MATERIAL");
+      return NULL;
+    }
+  REQUIRE_CLASS ("MATERIAL");
+  for (BITCODE_BS i = 0; i < dwg->num_classes; i++)
+    if (dwg->dwg_class[i].dxfname
+        && strEQc (dwg->dwg_class[i].dxfname, "MATERIAL"))
+      dwg->dwg_class[i].proxyflag = 1153; /* as AutoCAD writes it */
+  if (dwg->header_vars.DICTIONARY_MATERIAL
+      && dwg->header_vars.DICTIONARY_MATERIAL->absolute_ref)
+    {
+      dictobj = dwg_ref_object (dwg, dwg->header_vars.DICTIONARY_MATERIAL);
+      if (dictobj && dictobj->fixedtype == DWG_TYPE_DICTIONARY)
+        dict = dictobj->tio.object->tio.DICTIONARY;
+    }
+  if (!dict)
+    {
+      Dwg_Object_MATERIAL *bylayer;
+      dict = dwg_add_DICTIONARY (dwg, "ACAD_MATERIAL", NULL, 0);
+      if (!dict)
+        return NULL;
+      dict_ref = dwg_obj_generic_to_object (dict, &error)->handle.value;
+      dwg->header_vars.DICTIONARY_MATERIAL
+          = dwg_add_handleref (dwg, 5, dict_ref, NULL);
+      add_material (dwg, dict, dict_ref, "ByBlock");
+      bylayer = add_material (dwg, dict, dict_ref, "ByLayer");
+      add_material (dwg, dict, dict_ref, "Global");
+      dwg->header_vars.CMATERIAL = dwg_add_handleref (
+          dwg, 5, dwg_obj_generic_to_object (bylayer, &error)->handle.value,
+          NULL);
+    }
+  dict_ref = dwg_obj_generic_to_object (dict, &error)->handle.value;
+  return add_material (dwg, dict, dict_ref, name);
+}
