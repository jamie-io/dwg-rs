+/* Appends to an XRECORD in bulk: dwg_add_XRECORD_* walk the whole resbuf
+   chain for every value. */
+static Dwg_Resbuf *
+xrecord_append (Dwg_Object_XRECORD *_obj, Dwg_Resbuf **tail)
+{
+  Dwg_Resbuf *rbuf = (Dwg_Resbuf *)calloc (1, sizeof (Dwg_Resbuf));
+  if (!rbuf)
+    return NULL;
+  if (*tail)
+    (*tail)->nextrb = rbuf;
+  else
+    _obj->xdata = rbuf;
+  *tail = rbuf;
+  _obj->num_xdata++;
+  return rbuf;
+}
+
+/* size bytes of data as consecutive binary chunks of at most chunk bytes
+   (1 to 255, a single RC length each). */
+EXPORT Dwg_Object_XRECORD *
+dwg_add_XRECORD_chunks (Dwg_Object_XRECORD *restrict _obj, const short dxf,
+                        const size_t size, const BITCODE_RC *restrict data,
+                        const unsigned chunk)
+{
+  Dwg_Resbuf *tail;
+  size_t pos;
+  CHECK_XRECORD;
+  if (chunk < 1 || chunk > 255)
+    {
+      LOG_ERROR ("%s: invalid chunk size %u", __FUNCTION__, chunk);
+      return NULL;
+    }
+  tail = rbuf_last (_obj->xdata);
+  for (pos = 0; pos < size; pos += chunk)
+    {
+      const unsigned len
+          = size - pos < chunk ? (unsigned)(size - pos) : chunk;
+      Dwg_Resbuf *rbuf = xrecord_append (_obj, &tail);
+      if (!rbuf || !(rbuf->value.str.u.data = (char *)malloc (len)))
+        {
+          LOG_ERROR ("%s: Out of memory", __FUNCTION__);
+          return NULL;
+        }
+      rbuf->type = dxf;
+      rbuf->value.str.size = len;
+      memcpy (rbuf->value.str.u.data, &data[pos], len);
+      _obj->xdata_size += 3 + len; // 2 + 1 + len
+    }
+  return _obj;
+}
+
+/* num reals, value i with group code dxfs[i % num_dxfs] (e.g. 40, 41, 42 per
+   vertex normal). */
+EXPORT Dwg_Object_XRECORD *
+dwg_add_XRECORD_reals (Dwg_Object_XRECORD *restrict _obj,
+                       const unsigned num_dxfs, const short *restrict dxfs,
+                       const size_t num, const double *restrict values)
+{
+  Dwg_Resbuf *tail;
+  size_t i;
+  CHECK_XRECORD;
+  if (!num_dxfs)
+    return NULL;
+  tail = rbuf_last (_obj->xdata);
+  for (i = 0; i < num; i++)
+    {
+      Dwg_Resbuf *rbuf = xrecord_append (_obj, &tail);
+      if (!rbuf)
+        {
+          LOG_ERROR ("%s: Out of memory", __FUNCTION__);
+          return NULL;
+        }
+      rbuf->type = dxfs[i % num_dxfs];
+      rbuf->value.dbl = values[i];
+      _obj->xdata_size += 10; // 2 + 8
+    }
+  return _obj;
+}
+
+/* The extension dictionary of an entity or object, created on first use. */
+EXPORT Dwg_Object_DICTIONARY *
+dwg_add_xdictionary (const void *restrict _owner)
+{
+  int error;
+  Dwg_Object *owner = dwg_obj_generic_to_object (_owner, &error);
+  Dwg_Data *dwg = owner && !error ? owner->parent : NULL;
+  BITCODE_BL owner_index;
+  BITCODE_RLL owner_ref;
+  BITCODE_H xdic;
+  Dwg_Object_DICTIONARY *dict;
+  Dwg_Object *dictobj;
+  if (!dwg)
+    {
+      LOG_ERROR ("%s: no object", __FUNCTION__);
+      return NULL;
+    }
+  xdic = owner->supertype == DWG_SUPERTYPE_ENTITY
+             ? owner->tio.entity->xdicobjhandle
+             : owner->tio.object->xdicobjhandle;
+  if (xdic && xdic->absolute_ref)
+    {
+      Dwg_Object *o = dwg_ref_object (dwg, xdic);
+      return o && o->fixedtype == DWG_TYPE_DICTIONARY
+                 ? o->tio.object->tio.DICTIONARY
+                 : NULL;
+    }
+  /* dwg_add_DICTIONARY may move the owner */
+  owner_index = owner->index;
+  owner_ref = owner->handle.value;
+  dict = dwg_add_DICTIONARY (dwg, NULL, NULL, 0);
+  if (!dict)
+    return NULL;
+  owner = &dwg->object[owner_index];
+  dictobj = dwg_obj_generic_to_object (dict, &error);
+  dictobj->tio.object->ownerhandle
+      = dwg_add_handleref (dwg, 4, owner_ref, dictobj);
+  dict->is_hardowner = 1;
+  xdic = dwg_add_handleref (dwg, 3, dictobj->handle.value, owner);
+  if (owner->supertype == DWG_SUPERTYPE_ENTITY)
+    {
+      owner->tio.entity->xdicobjhandle = xdic;
+      owner->tio.entity->is_xdic_missing = 0;
+    }
+  else
+    {
+      owner->tio.object->xdicobjhandle = xdic;
+      owner->tio.object->is_xdic_missing = 0;
+    }
+  return dict;
+}
